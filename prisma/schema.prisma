generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PriceVisibility {
  PUBLIC
  HIDDEN
  FROM
}

enum SalesUnit {
  UNIDAD
  METRO
  ROLLO
  KG
  PAQUETE
  PANEL
  JUEGO
}

enum CtaType {
  ADD_TO_ORDER
  REQUEST_QUOTE
  CHECK_AVAILABILITY
  WHATSAPP
  BUILD_ORDER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  BORRADOR
  NUEVO
  ENVIADO_A_WHATSAPP
  CONTACTADO
  COTIZADO
  CONFIRMADO
  PREPARANDO
  LISTO
  ENTREGADO
  CANCELADO
}

enum Fulfillment {
  RETIRO
  ENVIO
}

enum StockMovementType {
  ENTRADA
  VENTA
  AJUSTE
  DEVOLUCION
  RESERVA
  CANCELACION
}

enum QuoteOrigin {
  CALCULATOR
  INSTALLATION
  MANUAL
}

enum QuoteStatus {
  NUEVA
  CONTACTADA
  COTIZADA
  CONVERTIDA
  CANCELADA
}

enum CustomerStatus {
  ACTIVO
  INACTIVO
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("VENDEDOR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  stockMoves    StockMovement[]
  statusChanges OrderStatusHistory[]
  customerNotes CustomerNote[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  filterKeys  String[]
  products    Product[]

  @@index([parentId])
}

model Product {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  sku                  String?          @unique
  categoryId           String
  category             Category         @relation(fields: [categoryId], references: [id])
  shortDescription     String
  technicalDescription String           @db.Text
  brand                String?
  salesUnit            SalesUnit
  priceVisibility      PriceVisibility  @default(HIDDEN)
  price                Decimal?         @db.Decimal(12, 2)
  ctaType              CtaType          @default(ADD_TO_ORDER)
  status               ProductStatus    @default(ACTIVE)
  featured             Boolean          @default(false)
  uses                 String[]
  seoTitle             String?
  seoDescription       String?
  documentationUrl     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  variants             ProductVariant[]
  images               ProductImage[]
  complements          ProductComplement[] @relation("ProductComplements")
  suggestedBy          ProductComplement[] @relation("SuggestedWith")

  @@index([categoryId, status])
  @@index([featured])
}

model ProductVariant {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String         @unique
  name       String
  attributes Json
  price      Decimal?       @db.Decimal(12, 2)
  salesUnit  SalesUnit?
  active     Boolean        @default(true)
  sourceReference String?
  reviewNote String?
  inventory  Inventory?
  movements  StockMovement[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
  sourceUrl String?
  isReference Boolean @default(false)
}

model ProductComplement {
  productId   String
  suggestedId String
  sortOrder   Int     @default(0)
  product     Product @relation("ProductComplements", fields: [productId], references: [id], onDelete: Cascade)
  suggested   Product @relation("SuggestedWith", fields: [suggestedId], references: [id], onDelete: Cascade)

  @@id([productId, suggestedId])
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand    Float          @default(0)
  reserved  Float          @default(0)
  minStock  Float          @default(0)
}

model StockMovement {
  id            String            @id @default(cuid())
  variantId     String
  variant       ProductVariant    @relation(fields: [variantId], references: [id])
  type          StockMovementType
  quantity      Float
  onHandAfter   Float
  reservedAfter Float
  reason        String
  reference     String?
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([variantId, createdAt])
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  phone     String         @unique
  email     String?
  locality  String?
  address   String?
  status    CustomerStatus @default(ACTIVO)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  addresses Address[]
  orders    Order[]
  quotes    Quote[]
  notes     CustomerNote[]
  tags      CustomerTag[]

  @@index([locality])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  line       String
  locality   String
  postalCode String?
  isDefault  Boolean  @default(false)
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  customers CustomerTag[]
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  body       String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model OrderCounter {
  id    Int @id @default(1)
  value Int @default(1047)
}

model Order {
  id             String      @id @default(cuid())
  number         Int         @unique
  status         OrderStatus @default(NUEVO)
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  fulfillment    Fulfillment
  locality       String
  address        String?
  notes          String?
  estimatedTotal Decimal?    @db.Decimal(12, 2)
  whatsappOpenedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  history        OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  name      String
  sku       String
  quantity  Decimal         @db.Decimal(12, 3)
  unit      SalesUnit
  unitPrice Decimal?        @db.Decimal(12, 2)
  lineTotal Decimal?        @db.Decimal(12, 2)
  notes     String?
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  number      Int         @unique
  origin      QuoteOrigin
  status      QuoteStatus @default(NUEVA)
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  name        String
  phone       String
  locality    String?
  address     String?
  notes       String?
  disclaimer  String
  payload     Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       QuoteItem[]

  @@index([status, createdAt])
}

model QuoteItem {
  id        String    @id @default(cuid())
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal   @db.Decimal(12, 3)
  unit      SalesUnit
  note      String?
}

model SiteSetting {
  key   String @id
  value String
}

// Shared across server instances; Better Auth applies atomic limits.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
}
